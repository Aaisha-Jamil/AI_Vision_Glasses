# Copy this file to .env and fill in your keys. Never commit .env.

# Free key: https://console.groq.com/keys
GROQ_API_KEY=Groq_API_KEY_Here

# groq = Groq cloud (fast, falls back to local on failure) | local = faster-whisper only
STT_PROVIDER=groq
# large-v3: Urdu / Urdu-English speech comes out as accurate English (language=en).
# turbo is faster to bill ($0.04 vs $0.111/h) but changed the meaning of Urdu speech in tests.
GROQ_STT_MODEL=whisper-large-v3
LOCAL_STT_MODEL=base

# Chunking: cut at the first 0.4 s pause after MIN seconds, forced cut at MAX.
# Groq bills each request as >= 10 s and the free tier allows 2,000 requests/day
# (shared by all users). Measured lecture capacity per day on the free tier:
#   3-7 s ~2.7 h (fastest live text) | 6-7 s ~3.6 h | 10-15 s ~6.1 h (text every 10-15 s)
MIN_CHUNK_SECONDS=3
MAX_CHUNK_SECONDS=7

# Noise flagging
# llm      = gpt-oss decides noise/mixed with a reason; falls back to two_pass if Groq fails
# two_pass = score against topic + batch centroid, sentence split for MIXED (no Groq calls)
# seed_only = score against the topic seed only
NOISE_SCORING=two_pass
NOISE_LLM_MODEL=openai/gpt-oss-20b
# one "lecture or chatter?" LLM call per flush when the topic is generic or the topic
# guard fires (catches chatter-only sessions, overrules a wrong topic); false = off
SESSION_CHECK=true
# 0 = no flush during the lecture, one embedding pass when the session stops
# >0 = also flush every N seconds (e.g. 60 for live alerts while testing)
FLUSH_INTERVAL_SECONDS=0
# a sentence scoring below this marks its chunk MIXED
SENTENCE_THRESHOLD=0.20
# chunks are grouped into containers of this length (built when the session stops)
CONTAINER_SECONDS=600

# Database (required): Supabase Postgres + pgvector.
# First run schema_postgres.sql in the Supabase SQL Editor, then paste the connection
#   string from Project -> Connect -> "Session pooler" or "Transaction pooler" (IPv4;
#   the "Direct connection" host is IPv6-only). Replace [YOUR-PASSWORD].
#   Pick the region closest to the users (Mumbai ap-south-1: ~65 ms per query from
#   Pakistan; Sydney was ~5x slower).
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Audio storage
# empty = chunks stay only on local disk (data/audio/)
# Supabase: first run supabase_storage.sql in the SQL Editor (creates the private bucket),
#   then set the project URL and the legacy "service_role" key (Project Settings ->
#   API Keys -> Legacy API Keys; starts with eyJ). The newer sb_secret_ keys were
#   rejected by Storage in our tests. Server-side only: never put this key in the app.
# Each transcribed chunk is uploaded as FLAC (~70 MB per lecture hour).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
AUDIO_BUCKET=lecture-audio
