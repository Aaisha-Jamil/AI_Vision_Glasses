# ==============================================================================
# AI Vision Glasses - Environment Configuration Template (.env.example)
# Copy this file to '.env' and populate with your credentials.
# NEVER commit the actual '.env' file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Configuration (PostgreSQL Database & Storage Buckets)
# ------------------------------------------------------------------------------
# Your Supabase project URL (e.g., https://your-project-ref.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon / Publishable API Key (safe for mobile application and client requests)
SUPABASE_KEY=your_supabase_anon_publishable_key_here

# Supabase Service Role Secret Key (used by backend for storage administration and background tasks)
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here

# Direct PostgreSQL connection string with pgvector extension enabled
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Supabase Storage Buckets
AUDIO_BUCKET=lecture-audio
SLIDES_BUCKET=lecture-slides

# ------------------------------------------------------------------------------
# 2. Audio Pipeline & Speech-To-Text (STT) Settings
# ------------------------------------------------------------------------------
# Groq API Key (required when STT_PROVIDER=groq or NOISE_SCORING=llm)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Speech-to-Text provider: 'groq' (cloud whisper-large-v3, fast) or 'local' (faster-whisper)
STT_PROVIDER=groq

# Model configurations
GROQ_STT_MODEL=whisper-large-v3
LOCAL_STT_MODEL=base.en

# Audio segment buffer bounds (in seconds)
MIN_CHUNK_SECONDS=2.0
MAX_CHUNK_SECONDS=10.0

# Noise scoring strategy: 'llm' (Groq LLM filter), 'embedding' (SentenceTransformer centroid), or 'none'
NOISE_SCORING=embedding
NOISE_LLM_MODEL=llama3-8b-8192

# Accumulator flush and container settings
FLUSH_INTERVAL_SECONDS=30.0
SENTENCE_THRESHOLD=4
CONTAINER_SECONDS=300.0

# User review timeout for flagged audio noise chunks (in seconds)
REVIEW_TIMEOUT_SECONDS=60.0

# ------------------------------------------------------------------------------
# 3. Computer Vision & Privacy Pipeline Settings
# ------------------------------------------------------------------------------
# Relative or absolute path to the fine-tuned YOLOv8 model weights
YOLO_MODEL_PATH=Image_input_pipeline/best.pt

# ------------------------------------------------------------------------------
# 4. FastAPI Backend Server Settings
# ------------------------------------------------------------------------------
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# ------------------------------------------------------------------------------
# 5. AI Note Synthesis & Document Generation (Gemini)
# ------------------------------------------------------------------------------
# Google Gemini API Key (obtain from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Storage Bucket for generated notes (.docx)
NOTES_BUCKET=lecture-notes
